{
  "name": "valme",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "test": "npm test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "audit": "tsx --env-file-if-exists=.env.local --env-file-if-exists=apps/web/.env.local --conditions=react-server packages/os/scripts/audit.ts",
    "probar:llm": "tsx --env-file-if-exists=.env.local --env-file-if-exists=apps/web/.env.local --conditions=react-server packages/os/scripts/probar-llm.ts",
    "worker": "npm run dev -w @valme/worker"
  },
  "devDependencies": {
    "tsx": "^4"
  }
}
