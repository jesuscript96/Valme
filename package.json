{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"src/os/**/__tests__/*.test.ts\"",
    "audit": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/audit.ts",
    "check": "tsc --noEmit && npm run lint:os && npm test",
    "lint:os": "eslint src/os scripts \"src/app/(os)\" src/app/api src/proxy.ts",
    "probar:llm": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/probar-llm.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@sanity/image-url": "^2.1.1",
