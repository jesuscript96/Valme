# Variables de entorno de Valme. Copia lo que necesites:
#   web     → apps/web/.env.local      (y en Vercel)
#   worker  → apps/worker/.env.local   (y como secrets en Coolify)
# Nunca subas valores reales: .env* está en .gitignore salvo este fichero.

# --- Web (apps/web) ------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=zsu74u9b
NEXT_PUBLIC_SANITY_DATASET=production
# 1 para leer el contenido de Sanity; sin ella la web usa apps/web/src/content/seed.ts
NEXT_PUBLIC_USE_SANITY=
SANITY_REVALIDATE_SECRET=
# Login del área de admin (falso: cookie firmada + contraseña compartida)
OS_SESSION_SECRET=
OS_ACCESS_PASSWORD=

# --- Supabase (worker; la web cuando entre Supabase Auth) ----------------------
SUPABASE_URL=https://tvgtknxjaaughmqpspap.supabase.co
# Se salta RLS. Sólo en el servidor: worker y, más adelante, código de servidor de la web.
SUPABASE_SERVICE_ROLE_KEY=
# Para la web cuando lea con la sesión del usuario (RLS). Pública por diseño.
SUPABASE_ANON_KEY=

# --- Claude ----------------------------------------------------------------------
# OS_LLM_API_KEY tiene prioridad sobre ANTHROPIC_API_KEY (ver packages/os/src/providers/anthropic.ts)
OS_LLM_API_KEY=
# Por defecto claude-opus-5-5
OS_LLM_MODEL=
# Sólo para probar otro proveedor compatible; el worker necesita Anthropic de verdad
OS_LLM_BASE_URL=

# --- Worker (apps/worker) --------------------------------------------------------
# Navegador del sandbox: ws://<host-del-sandbox>:3000/<SANDBOX_TOKEN>.
# Vacío = Chrome local (sólo desarrollo).
SANDBOX_URL=
PORT=8080
WORKER_CONCURRENCY=1
WORKER_POLL_MS=3000
WORKER_VISIBILITY_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_RUN_TIMEOUT_SECONDS=1800

# --- Sandbox (apps/worker/sandbox) ----------------------------------------------
# Secreto compartido con el worker (va en la ruta de SANDBOX_URL). Mínimo 24 caracteres.
SANDBOX_TOKEN=
# Opcional: otro Chromium (por defecto, el que instala Playwright en la imagen)
CHROME_PATH=

# --- Proveedores de la auditoría y de las cuentas ----------------------------------
PAGESPEED_API_KEY=
META_ADLIB_TOKEN=
META_API_VERSION=
META_APP_ID=
META_APP_SECRET=
FIRECRAWL_API_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
RESEND_API_KEY=
